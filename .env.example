# Your Gmail address (the one that sends the quote and review emails)
GMAIL_USER=goldexterior0@gmail.com

# Gmail App Password — NOT your regular password.
# Generate one at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be on)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where quote requests and review submissions are delivered
# (defaults to goldexterior0@gmail.com if omitted)
QUOTE_TO_EMAIL=goldexterior0@gmail.com

# REQUIRED for the reviews page. The code a customer must enter to submit a
# review at /reviews — hand it out when a job wraps. With this unset the form
# accepts nothing at all, which is deliberate: there is no default, because a
# default committed to a public repo would be a published password.
#
# Put your real code in .env.local and in your host's environment variables,
# never in a file that gets committed. Case and punctuation are ignored, so
# "two words 2026" and "TWO-WORDS-2026" are the same answer.
REVIEW_CODE=pick-your-own-and-keep-it-out-of-git
