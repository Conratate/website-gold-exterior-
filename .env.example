# Your Gmail address (the one that sends the quote and review emails)
GMAIL_USER=goldexterior0@gmail.com

# Gmail App Password — NOT your regular password.
# Generate one at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be on)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where quote requests and review submissions are delivered
# (defaults to goldexterior0@gmail.com if omitted)
QUOTE_TO_EMAIL=goldexterior0@gmail.com

# ── Reviews ─────────────────────────────────────────────────────────────────
# Both are REQUIRED for the reviews page. With either unset the relevant form
# refuses everything — failing closed is the only safe way to be misconfigured.

# Signs the per-job review codes. A long random string; nobody ever types it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Treat it like a password: never commit it. Changing it invalidates every code
# still out in the wild, which is your emergency stop if one ever gets abused.
REVIEW_CODE_SECRET=generate-your-own-and-keep-it-out-of-git

# Your password for /reviews/new-code, the page where you issue a customer
# their code. Only you ever see this one — it is not the code customers use.
OWNER_CODE=pick-your-own-and-keep-it-out-of-git
